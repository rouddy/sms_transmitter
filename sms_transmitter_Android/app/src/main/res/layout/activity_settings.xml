<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@id/input_server_url"
        android:text="@string/server_url_label" />

    <EditText
        android:id="@+id/input_server_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/server_url_label"
        android:hint="@string/server_url_hint"
        android:inputType="textUri"
        android:importantForAutofill="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:labelFor="@id/input_phone_numbers"
        android:text="@string/phone_numbers_label" />

    <EditText
        android:id="@+id/input_phone_numbers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/phone_numbers_label"
        android:hint="@string/phone_numbers_hint"
        android:inputType="textMultiLine"
        android:minLines="2" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/phone_number_limits_label" />

    <LinearLayout
        android:id="@+id/phone_number_limits_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_overlay_ui"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/overlay_ui_toggle" />

    <Button
        android:id="@+id/button_save_limits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/save" />
</LinearLayout>
