<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}관리자{% endblock title %} · SMS Transmitter</title>
  <style>
    :root { --fg: #1f2328; --muted: #656d76; --border: #d0d7de; --bg: #f6f8fa; --accent: #0969da; --ok: #1a7f37; --warn: #9a6700; --err: #cf222e; }
    * { box-sizing: border-box; }
    body { margin: 0; font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Malgun Gothic", sans-serif; color: var(--fg); background: var(--bg); }
    a { color: var(--accent); }
    header { display: flex; align-items: center; gap: 24px; padding: 10px 24px; background: #fff; border-bottom: 1px solid var(--border); }
    header .brand { font-weight: 600; color: var(--fg); text-decoration: none; }
    header nav { display: flex; gap: 16px; flex: 1; }
    header nav a { color: var(--muted); text-decoration: none; padding: 4px 0; border-bottom: 2px solid transparent; }
    header nav a.active { color: var(--fg); border-bottom-color: var(--accent); font-weight: 600; }
    main { max-width: 1200px; margin: 24px auto; padding: 0 24px; }
    h1 { font-size: 20px; margin: 0 0 16px; }
    h2 { font-size: 16px; margin: 24px 0 8px; }
    .card { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 16px; margin-bottom: 16px; }
    .card h2 { margin: 0; }
    .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 6px; background: #fff; margin-bottom: 8px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
    tr:last-child td { border-bottom: 0; }
    th { background: var(--bg); font-weight: 600; white-space: nowrap; }
    .muted, .hint { color: var(--muted); }
    .hint { display: block; font-weight: normal; font-size: 12px; margin: 2px 0 8px; }
    .text-err { color: var(--err); font-size: 12px; }
    .small { font-size: 12px; font-weight: normal; margin-left: 8px; }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; word-break: break-all; }
    .nowrap { white-space: nowrap; }
    .badge { display: inline-block; padding: 0 8px; border-radius: 10px; font-size: 12px; font-weight: normal; border: 1px solid currentColor; white-space: nowrap; }
    .badge.ok { color: var(--ok); } .badge.warn { color: var(--warn); } .badge.err { color: var(--err); } .badge.off { color: var(--muted); }
    .flash { padding: 8px 12px; border-radius: 6px; margin-bottom: 16px; border: 1px solid; }
    .flash.success { color: var(--ok); background: #dafbe1; }
    .flash.error { color: var(--err); background: #ffebe9; }
    .flash.warning { color: var(--warn); background: #fff8c5; }
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 8px; }
    .stat { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 12px; }
    .stat .value { font-size: 22px; font-weight: 600; }
    .toolbar { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 12px; }
    .toolbar h1 { margin: 0; }
    .spacer { flex: 1; }
    form.inline { display: inline; }
    label { display: block; margin-bottom: 12px; font-weight: 600; }
    label.inline { display: inline-flex; gap: 4px; align-items: center; font-weight: normal; margin: 0 12px 0 0; }
    input:not([type=radio]):not([type=checkbox]), textarea, select { font: inherit; padding: 5px 8px; border: 1px solid var(--border); border-radius: 6px; width: 100%; background: #fff; }
    input[readonly] { background: var(--bg); color: var(--muted); }
    .toolbar input:not([type=radio]), .toolbar select { width: auto; }
    td input:not([type=radio]) { min-width: 90px; }
    button, .button { font: inherit; padding: 5px 12px; border: 1px solid var(--border); border-radius: 6px; background: #fff; color: var(--fg); cursor: pointer; text-decoration: none; display: inline-block; }
    .primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .danger { color: var(--err); }
    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; }
    dl { display: grid; grid-template-columns: 140px 1fr; gap: 6px 16px; margin: 0; }
    dt { color: var(--muted); }
    dd { margin: 0; word-break: break-all; }
    pre { white-space: pre-wrap; word-break: break-all; background: var(--bg); padding: 8px; border-radius: 6px; margin: 0; max-height: 320px; overflow: auto; font-size: 13px; }
    .narrow { max-width: 560px; margin: 48px auto; }
    .pagination { display: flex; gap: 8px; align-items: center; }
  </style>
</head>
<body>
{% block nav %}
<header>
  <a class="brand" href="/admin">SMS Transmitter</a>
  <nav>
    <a href="/admin" class="{% if active == 'overview' %}active{% endif %}">개요</a>
    <a href="/admin/devices" class="{% if active == 'devices' %}active{% endif %}">기기</a>
    <a href="/admin/sms-requests" class="{% if active == 'sms' %}active{% endif %}">SMS 요청</a>
  </nav>
  {% if csrf is defined %}
  <form method="post" action="/admin/logout">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <button>로그아웃</button>
  </form>
  {% endif %}
</header>
{% endblock nav %}
<main>
  {% block session %}
  <div id="session-expired" class="flash warning" hidden>
    세션이 만료되었습니다. <a href="/admin/login">다시 로그인</a>하세요.
  </div>
  <script>
    // Keeps the admin session alive while this page is open. Once every admin page is
    // closed the heartbeats stop and the session expires a few minutes later.
    const heartbeat = setInterval(() => {
      fetch('/admin/heartbeat', { method: 'POST' })
        .then((response) => {
          // An expired session is redirected to the login page.
          if (response.redirected) {
            clearInterval(heartbeat);
            document.getElementById('session-expired').hidden = false;
          }
        })
        .catch(() => {});
    }, {{ heartbeat_ms }});
  </script>
  {% endblock session %}
  {% if flash is defined %}<div class="flash {{ flash.kind }}">{{ flash.message }}</div>{% endif %}
  {% block content %}{% endblock content %}
</main>
</body>
</html>
